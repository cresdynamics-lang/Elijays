# --- App ---
DATABASE_URL="postgresql://elijays:elijays@localhost:5434/elijays?schema=public"
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_APP_URL="https://elijays-mens-wear.co.ke"
NODE_ENV="development"
PORT="3010"

# --- AI product copy via Groq (admin upload → name + SEO description) ---
# https://console.groq.com/keys
GROQ_API_KEY="YOUR_GROQ_API_KEY"
GROQ_VISION_MODEL="qwen/qwen3.8-27b"

# --- Meta Pixel / Commerce ---
NEXT_PUBLIC_META_PIXEL_ID="YOUR_META_PIXEL_ID"
META_CATALOG_ID="YOUR_META_CATALOG_ID"
META_ACCESS_TOKEN="YOUR_META_ACCESS_TOKEN"
META_CAPI_ACCESS_TOKEN="YOUR_META_CAPI_ACCESS_TOKEN"
META_CAPI_PIXEL_ID="YOUR_META_PIXEL_ID"
META_CAPI_TEST_EVENT_CODE=""

# --- Co-op Bank Connect (live STK — not Safaricom Daraja) ---
# Developer portal: https://developer.co-opbank.co.ke
# Live API host: https://openapi.co-opbank.co.ke
COOP_ENV="production"
COOP_BASE_URL="https://openapi.co-opbank.co.ke"
COOP_TOKEN_URL="https://openapi.co-opbank.co.ke/token"
COOP_STK_PATH="/FT/stk/1.0.0"
COOP_STATUS_PATH="/Enquiry/STK/1.0.0/"
COOP_OPERATOR_CODE="ELIJAYS"
COOP_CONSUMER_KEY="YOUR_COOP_CONSUMER_KEY"
COOP_CONSUMER_SECRET="YOUR_COOP_CONSUMER_SECRET"
COOP_CLIENT_ID="YOUR_COOP_CLIENT_ID"
COOP_CLIENT_SECRET="YOUR_COOP_CLIENT_SECRET"
COOP_API_KEY="YOUR_COOP_API_KEY"
COOP_ACCOUNT_NUMBER="YOUR_COOP_ACCOUNT_NUMBER"
COOP_BRANCH_CODE="YOUR_BRANCH_CODE"
# Register this callback URL on the Co-op application
COOP_CALLBACK_URL="https://elijays-mens-wear.co.ke/api/payments/mpesa/callback"
COOP_WEBHOOK_SECRET="YOUR_COOP_WEBHOOK_SECRET"

# --- Co-op / Chapa Pay (card e-commerce) ---
CHAPA_PAY_ENABLED="true"
CHAPA_PUBLIC_KEY="YOUR_CHAPA_PUBLIC_KEY"
CHAPA_SECRET_KEY="YOUR_CHAPA_SECRET_KEY"
CHAPA_WEBHOOK_SECRET="YOUR_CHAPA_WEBHOOK_SECRET"
CHAPA_CALLBACK_URL="https://elijays-mens-wear.co.ke/api/payments/chapa/webhook"
CHAPA_RETURN_URL="https://elijays-mens-wear.co.ke/checkout/success"

# --- Payment behaviour ---
PAYMENTS_MPESA_ENABLED="true"
PAYMENTS_CARD_ENABLED="true"
PAYMENTS_COD_ENABLED="true"
PAYMENT_CURRENCY="KES"
