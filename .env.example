# --- App ---
DATABASE_URL="postgresql://elijays:elijays@localhost:5434/elijays?schema=public"
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_APP_URL="https://elijays-mens-wear.co.ke"
NODE_ENV="development"
PORT="3010"

# --- AI product copy (admin upload → name + SEO description) ---
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
OPENAI_VISION_MODEL="gpt-4o-mini"

# --- Meta Pixel / Commerce ---
NEXT_PUBLIC_META_PIXEL_ID="YOUR_META_PIXEL_ID"
META_CATALOG_ID="YOUR_META_CATALOG_ID"
META_ACCESS_TOKEN="YOUR_META_ACCESS_TOKEN"
# Optional Conversions API (server-side events)
META_CAPI_ACCESS_TOKEN="YOUR_META_CAPI_ACCESS_TOKEN"
META_CAPI_PIXEL_ID="YOUR_META_PIXEL_ID"
META_CAPI_TEST_EVENT_CODE=""

# --- Co-op Bank Connect (M-Pesa STK + account APIs) ---
# Sandbox: https://openapi-sandbox.co-opbank.co.ke
# Production: https://openapi.co-opbank.co.ke
COOP_ENV="sandbox"
COOP_BASE_URL="https://openapi-sandbox.co-opbank.co.ke"
COOP_CLIENT_ID="YOUR_COOP_CLIENT_ID"
COOP_CLIENT_SECRET="YOUR_COOP_CLIENT_SECRET"
COOP_API_KEY="YOUR_COOP_API_KEY"
COOP_CONSUMER_KEY="YOUR_COOP_CONSUMER_KEY"
COOP_CONSUMER_SECRET="YOUR_COOP_CONSUMER_SECRET"
# Collection / till used for STK Push
COOP_MPESA_SHORTCODE="YOUR_TILL_OR_PAYBILL"
COOP_MPESA_PASSKEY="YOUR_MPESA_PASSKEY"
COOP_ACCOUNT_NUMBER="YOUR_COOP_ACCOUNT_NUMBER"
COOP_BRANCH_CODE="YOUR_BRANCH_CODE"
# Webhook / callback (must match bank allow-list)
COOP_CALLBACK_URL="https://elijays-mens-wear.co.ke/api/payments/coop/webhook"
COOP_WEBHOOK_SECRET="YOUR_COOP_WEBHOOK_SECRET"

# --- Co-op / Chapa Pay (card e-commerce) ---
CHAPA_PAY_ENABLED="true"
CHAPA_PUBLIC_KEY="YOUR_CHAPA_PUBLIC_KEY"
CHAPA_SECRET_KEY="YOUR_CHAPA_SECRET_KEY"
CHAPA_WEBHOOK_SECRET="YOUR_CHAPA_WEBHOOK_SECRET"
CHAPA_CALLBACK_URL="https://elijays-mens-wear.co.ke/api/payments/chapa/webhook"
CHAPA_RETURN_URL="https://elijays-mens-wear.co.ke/checkout/success"

# --- Safaricom Daraja M-Pesa STK (preferred for Lipa Na M-Pesa Online) ---
# Falls back to COOP_CONSUMER_* / COOP_MPESA_* if these are empty.
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY="YOUR_MPESA_CONSUMER_KEY"
MPESA_CONSUMER_SECRET="YOUR_MPESA_CONSUMER_SECRET"
MPESA_SHORTCODE="YOUR_MPESA_SHORTCODE"
MPESA_PASSKEY="YOUR_MPESA_PASSKEY"
MPESA_CALLBACK_URL="https://elijays-mens-wear.co.ke/api/payments/mpesa/callback"

# --- Payment behaviour ---
PAYMENTS_MPESA_ENABLED="true"
PAYMENTS_CARD_ENABLED="true"
PAYMENTS_COD_ENABLED="true"
PAYMENT_CURRENCY="KES"
